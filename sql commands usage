create database sairam;
use sairam; 
create table students(
s_id int primary key auto_increment,
s_name varchar(255),
age bigint,
city varchar(255)
);
create table employees(
e_id int primary key auto_increment,
e_name varchar(50),
salary decimal(10,2),
department varchar(30)
);
create table products(
p_id int,
P_name varchar(20),
price bigint,
stock int
);
